DATABASE_URL=postgresql+asyncpg://personal_finance_platform:personal_finance_platform@localhost:5433/personal_finance_platform
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Must be overridden to a long random value outside development —
# Settings.assert_safe_for_environment() refuses to boot in production
# with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://localhost:6380/0

# Optional (Twelve Data). Without it, POST /investments/prices/refresh
# returns 503 and holdings/watchlist entries simply keep
# latest_price_minor=null — no mock/synthetic price is ever substituted.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# Optional (Plaid sandbox). Without it, POST /institutions/link-token and
# POST /institutions both return 503 rather than a fake link flow.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Required only once an institution is actually linked (ADR-0003).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
