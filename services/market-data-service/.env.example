DATABASE_URL=postgresql+asyncpg://personal_finance_platform:personal_finance_platform@localhost:5433/personal_finance_platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional (Twelve Data) — without it, the poll loop logs and skips
# every cycle rather than erroring. Same key apps/core-api's on-demand
# refresh endpoint uses.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com

POLL_INTERVAL_SECONDS=300
HEALTH_CHECK_PORT=8083
