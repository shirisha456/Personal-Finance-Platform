# Copy this to /opt/personal-finance-platform/secrets.env on the host (never commit the
# real file), then: chmod 600 /opt/personal-finance-platform/secrets.env
#
# Referenced by deploy/docker-compose.prod.yml's env_file: entries.

# Same password in both — POSTGRES_PASSWORD configures the postgres
# image itself; DATABASE_URL is what core-api/enrichment-service/
# anomaly-service actually connect with. They must match.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://personal_finance_platform:change-me@postgres:5432/personal_finance_platform

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# See ADR-0003 — this is a local stand-in for real KMS envelope
# encryption (infra/terraform/modules/iam creates the real KMS key this
# would become if this Terraform is ever actually applied — see
# docs/adr/0011-terraform-written-not-applied.md).
ENCRYPTION_KEY=

# Optional — leave blank and the feature it backs degrades gracefully
# (see README.md "External integration behavior").
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
OPENAI_API_KEY=
MARKET_DATA_API_KEY=

# Grafana admin login — anonymous access is off in production (see
# docker-compose.prod.yml). Username is always "admin".
GF_SECURITY_ADMIN_PASSWORD=change-me
